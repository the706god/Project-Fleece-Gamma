{
  "project_name": "Project: Fleece Gamma",
  "version": "1.1.0",
  "model_type": "reasoning-slm",
  "base_model": "Qwen 3.5 9B Instruct",
  "model_path": "models/model.gguf",
  "engine": {
    "n_ctx": 65536,
    "n_gpu_layers": -1,
    "flash_attn": true,
    "kv_cache_type_k": "turbo4",
    "kv_cache_type_v": "turbo4",
    "kv_fallback_type": "q8_0",
    "turbo_sparse_v": true,
    "turbo_auto_asymmetric": true,
    "temperature": 0.6,
    "top_p": 0.95,
    "top_k": 20,
    "repeat_penalty": 1.0,
    "default_reasoning_mode": "einstein"
  },
  "memory": {
    "max_context_tokens": 65536,
    "reserved_completion_tokens": 4096,
    "system_anchor_tokens": 1200,
    "memory_compaction_threshold": 0.85,
    "prioritize_ingested_docs_over_history": true,
    "strip_thinking_from_history": true
  },
  "ingestion": {
    "anti_parsing": true,
    "anti_chunking": true,
    "anti_truncating": true,
    "max_block_tokens": 8192,
    "strict_unbroken_retention": true
  },
  "storage": {
    "markdown_root": "storage/markdown"
  }
}